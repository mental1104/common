# NAS 上 workflow 的绝对路径。
WORKFLOW_ROOT=/volume2/workflow

# 开发容器缓存与 SSH 主机密钥存放路径，建议位于 SSD 卷。
DEVCONTAINER_DATA_ROOT=/volume2/workflow/.devcontainer-state

# 必须与 NAS 上 workflow/common 的文件所有者 UID/GID 匹配。
# 在 NAS SSH 中执行：stat -c '%u:%g' /volume2/workflow/common
DEV_UID=1026
DEV_GID=100

# VS Code 直接 SSH 连接开发容器使用的 NAS 端口。
DEVCONTAINER_SSH_PORT=2222

# 监听 NAS 网络接口。请在群晖防火墙中仅允许可信 LAN/VPN 网段访问该端口，
# 不要在路由器上将此端口转发到公网。
DEVCONTAINER_SSH_BIND=0.0.0.0
