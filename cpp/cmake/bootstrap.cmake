# 独立构建默认准备依赖；嵌入其他工程、CI 和交叉编译保持由调用方提供依赖。
set(_m1104_auto_default OFF)
if((PROJECT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR OR M1104_ROOT_ENTRY)
    AND NOT CMAKE_CROSSCOMPILING AND NOT DEFINED ENV{CI})
  set(_m1104_auto_default ON)
endif()
option(M1104_AUTO_SETUP "Prepare C++ source and binary dependencies during configuration" ${_m1104_auto_default})
set(M1104_DEPENDENCY_JOBS "4" CACHE STRING "Parallel jobs for dependency preparation")
set(M1104_DEPENDENCY_ROOT "${CMAKE_BINARY_DIR}/_deps" CACHE PATH "Build-local SDK directory")

set(_m1104_apt_default OFF)
if(M1104_AUTO_SETUP AND CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux"
    AND EXISTS "/etc/debian_version" AND NOT CMAKE_CROSSCOMPILING)
  set(_m1104_apt_default ON)
endif()
option(M1104_INSTALL_SYSTEM_DEPS "Prepare missing Debian/Ubuntu development packages with apt" ${_m1104_apt_default})
set(M1104_MQ_APT_DEFAULT OFF)

if(M1104_AUTO_SETUP)
  if(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Disable M1104_AUTO_SETUP and provide target SDKs when cross compiling")
  endif()
  if(M1104_INSTALL_SYSTEM_DEPS)
    if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" OR NOT EXISTS "/etc/debian_version")
      message(FATAL_ERROR "M1104_INSTALL_SYSTEM_DEPS requires Debian/Ubuntu apt; provide native development packages on this host")
    endif()
    include("${CMAKE_CURRENT_LIST_DIR}/mq_apt_dependencies.cmake")
    # CMake 与编译器本身属于启动条件；以下包由配置阶段补齐。
    set(_m1104_packages git python3 pkg-config libboost-dev)
    if(NOT DEFINED M1104_ENABLE_HIGH_PRECISION OR M1104_ENABLE_HIGH_PRECISION)
      list(APPEND _m1104_packages libgmp-dev libmpfr-dev)
    endif()
    if((NOT DEFINED ENABLE_COVERAGE OR ENABLE_COVERAGE)
        OR (NOT DEFINED COVERAGE OR COVERAGE))
      list(APPEND _m1104_packages lcov)
    endif()
    set(_m1104_missing "")
    foreach(_package IN LISTS _m1104_packages)
      _m1104_mq_packages_installed(_installed "${_package}")
      if(NOT _installed)
        list(APPEND _m1104_missing "${_package}")
      endif()
    endforeach()
    if(_m1104_missing)
      execute_process(COMMAND id -u OUTPUT_VARIABLE _uid OUTPUT_STRIP_TRAILING_WHITESPACE)
      set(_m1104_sudo_prefix "")
      if(NOT _uid STREQUAL "0")
        find_program(_m1104_sudo sudo)
        if(NOT _m1104_sudo)
          message(FATAL_ERROR "Automatic dependency preparation needs root or sudo; disable M1104_INSTALL_SYSTEM_DEPS to use preinstalled packages")
        endif()
        set(_m1104_sudo_prefix "${_m1104_sudo}" -n)
      endif()
      find_program(_m1104_apt_get apt-get)
      if(NOT _m1104_apt_get)
        message(FATAL_ERROR "apt-get is required for automatic system dependency preparation")
      endif()
      _m1104_mq_run_apt(${_m1104_sudo_prefix} "${_m1104_apt_get}" update)
      _m1104_mq_run_apt(${_m1104_sudo_prefix} "${_m1104_apt_get}" install -y --no-install-recommends ${_m1104_missing})
    endif()
    set(M1104_MQ_APT_DEFAULT ON)
  endif()

  find_program(M1104_BOOTSTRAP_PYTHON NAMES python3 python)
  if(NOT M1104_BOOTSTRAP_PYTHON)
    message(FATAL_ERROR "Python 3 is required for automatic C++ source preparation; install it or disable M1104_AUTO_SETUP")
  endif()
  get_filename_component(_m1104_repository "${PROJECT_SOURCE_DIR}/.." ABSOLUTE)
  set(_m1104_bootstrap_args
    --dependency-root "${M1104_DEPENDENCY_ROOT}"
    --standard "${CMAKE_CXX_STANDARD}"
    --jobs "${M1104_DEPENDENCY_JOBS}"
    --build-type "${CMAKE_BUILD_TYPE}"
    --cmake "${CMAKE_COMMAND}")
  # SDK 使用当前工程选定的编译器和 ABI 标志，不能重新选回系统默认编译器。
  foreach(_setting IN ITEMS CMAKE_C_COMPILER CMAKE_CXX_COMPILER
      CMAKE_C_FLAGS CMAKE_CXX_FLAGS CMAKE_OSX_ARCHITECTURES CMAKE_OSX_SYSROOT
      CMAKE_OSX_DEPLOYMENT_TARGET)
    if(DEFINED ${_setting} AND NOT "${${_setting}}" STREQUAL "")
      string(REPLACE ";" "\\;" _value "${${_setting}}")
      list(APPEND _m1104_bootstrap_args "--cmake-arg=-D${_setting}=${_value}")
    endif()
  endforeach()
  if(NOT WIN32 AND (NOT DEFINED M1104_ENABLE_REDIS_LOCK OR M1104_ENABLE_REDIS_LOCK))
    list(APPEND _m1104_bootstrap_args --redis-enabled)
  endif()
  if(AUTO_FETCH_SUBMODULES)
    list(APPEND _m1104_bootstrap_args --fetch-sources)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "PYTHONPATH=${_m1104_repository}/devops"
      "${M1104_BOOTSTRAP_PYTHON}" -m devtool.bootstrap_cpp ${_m1104_bootstrap_args}
    WORKING_DIRECTORY "${_m1104_repository}" RESULT_VARIABLE _m1104_bootstrap_status)
  if(NOT _m1104_bootstrap_status EQUAL 0)
    message(FATAL_ERROR "Automatic C++ dependency preparation failed (${_m1104_bootstrap_status})")
  endif()
endif()
