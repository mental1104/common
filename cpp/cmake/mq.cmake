option(M1104_ENABLE_KAFKA "Enable librdkafka-backed message queue adapter when available" ON)
option(M1104_ENABLE_PULSAR "Enable pulsar-client-cpp-backed adapter when available" ON)
option(M1104_BUILD_MQ_EXAMPLES "Build the no-broker MQ Bridge example" ON)
option(M1104_INSTALL_MQ_DEPS "Explicitly prepare enabled MQ SDKs with apt on Debian/Ubuntu" OFF)

set(_m1104_prepare_mq FALSE)
if(M1104_INSTALL_MQ_DEPS OR M1104_MQ_APT_DEFAULT)
  set(_m1104_prepare_mq TRUE)
  include("${CMAKE_CURRENT_LIST_DIR}/mq_apt_dependencies.cmake")
  m1104_install_mq_apt_dependencies()
endif()

if(M1104_ENABLE_KAFKA)
  find_path(M1104_RDKAFKA_INCLUDE_DIR librdkafka/rdkafkacpp.h)
  find_library(M1104_RDKAFKA_CPP_LIBRARY NAMES rdkafka++)
  find_library(M1104_RDKAFKA_C_LIBRARY NAMES rdkafka)
  if(M1104_RDKAFKA_INCLUDE_DIR AND M1104_RDKAFKA_CPP_LIBRARY AND M1104_RDKAFKA_C_LIBRARY)
    add_library(M1104::KafkaSDK INTERFACE IMPORTED)
    set_target_properties(M1104::KafkaSDK PROPERTIES
      INTERFACE_INCLUDE_DIRECTORIES "${M1104_RDKAFKA_INCLUDE_DIR}"
      INTERFACE_LINK_LIBRARIES "${M1104_RDKAFKA_CPP_LIBRARY};${M1104_RDKAFKA_C_LIBRARY}")
    target_link_libraries(mental1104 PRIVATE M1104::KafkaSDK)
    target_compile_definitions(mental1104 PUBLIC M1104_HAS_RDKAFKA=1)
    message(STATUS "Kafka MQ backend enabled")
  else()
    if(_m1104_prepare_mq)
      message(FATAL_ERROR "Kafka SDK was requested but headers/libraries are still missing after apt preparation")
    endif()
    message(STATUS "Kafka MQ backend disabled: librdkafka C++ headers/libraries not found")
  endif()
endif()

if(M1104_ENABLE_PULSAR)
  if(DEFINED CMAKE_CXX_STANDARD AND CMAKE_CXX_STANDARD LESS 17)
    message(STATUS "Pulsar MQ backend disabled for C++${CMAKE_CXX_STANDARD}; current pulsar-client-cpp requires C++17+")
  else()
    find_path(M1104_PULSAR_INCLUDE_DIR pulsar/Client.h)
    find_library(M1104_PULSAR_LIBRARY NAMES pulsar)
    if(M1104_PULSAR_INCLUDE_DIR AND M1104_PULSAR_LIBRARY)
      add_library(M1104::PulsarSDK INTERFACE IMPORTED)
      set_target_properties(M1104::PulsarSDK PROPERTIES
        INTERFACE_INCLUDE_DIRECTORIES "${M1104_PULSAR_INCLUDE_DIR}"
        INTERFACE_LINK_LIBRARIES "${M1104_PULSAR_LIBRARY}")
      target_link_libraries(mental1104 PRIVATE M1104::PulsarSDK)
      target_compile_definitions(mental1104 PUBLIC M1104_HAS_PULSAR=1)
      # 4.2 起旧 createProducer 被弃用；探测真实头和库，兼容仍使用旧 API 的 SDK。
      include(CheckCXXSourceCompiles)
      include(CMakePushCheckState)
      cmake_push_check_state(RESET)
      set(CMAKE_REQUIRED_INCLUDES "${M1104_PULSAR_INCLUDE_DIR}")
      set(CMAKE_REQUIRED_LIBRARIES "${M1104_PULSAR_LIBRARY}")
      unset(M1104_PULSAR_HAS_CREATE_PRODUCER_V2 CACHE)
      check_cxx_source_compiles("#include <pulsar/Client.h>
// 只编译链接，不执行网络操作。
int main() { pulsar::Client client(\"pulsar://127.0.0.1:6650\");
  auto result = client.createProducerV2(\"topic\", pulsar::ProducerConfiguration());
  (void)result; return 0; }" M1104_PULSAR_HAS_CREATE_PRODUCER_V2)
      cmake_pop_check_state()
      if(M1104_PULSAR_HAS_CREATE_PRODUCER_V2)
        target_compile_definitions(mental1104 PRIVATE M1104_PULSAR_HAS_CREATE_PRODUCER_V2=1)
      endif()
      message(STATUS "Pulsar MQ backend enabled")
    else()
      if(_m1104_prepare_mq)
        message(FATAL_ERROR "Pulsar SDK was requested but headers/libraries are still missing after apt preparation")
      endif()
      message(STATUS "Pulsar MQ backend disabled: pulsar-client-cpp headers/library not found")
    endif()
  endif()
endif()

if(M1104_BUILD_MQ_EXAMPLES)
  add_executable(m1104_mq_bridge_demo "${PROJECT_SOURCE_DIR}/examples/mq_bridge_demo.cpp")
  target_link_libraries(m1104_mq_bridge_demo PRIVATE mental1104)
  target_include_directories(m1104_mq_bridge_demo PRIVATE "${PROJECT_SOURCE_DIR}/include")
endif()
