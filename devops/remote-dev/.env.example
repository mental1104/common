# NAS SSD 上的工作区根目录，容器会将整个目录挂载到 /workspace/workflow。
WORKFLOW_ROOT=/volume2/workflow

# common 仓库在 NAS 上的实际路径；该目录会同时映射到 /opt/mental1104。
COMMON_REPO_ROOT=/volume2/workflow/common

# 所有持久化运行数据放在 SSD。
DEV_DATA_ROOT=/volume2/docker/common-dev

# 开发容器 SSH 端口。
COMMON_DEV_SSH_PORT=31104

# 可选的 HTTP 调试端口映射，仅绑定 NAS 回环地址。
COMMON_DEV_HTTP_PORT=8080

# 必须与 NAS 上拥有 workflow 仓库的用户 UID/GID 一致。
# 常见 Synology 默认值是 1026:100，部署前请用 id 命令核对。
DEV_UID=1026
DEV_GID=100

# 为避免开发编译挤占其他 Homelab 服务，默认限制为 3 GiB 内存和 2 个 CPU。
COMMON_DEV_MEM_LIMIT=3g
COMMON_DEV_CPUS=2.0
